# --- MOznoDS Production Configuration ---
# Copy this file to .env and fill in your values

# 1. Server Domain
DOMAIN=your-domain.com
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# 2. Security & Credentials
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-here
# Calls (LiveKit). Key: any id; secret: at least 32 random chars (openssl rand -hex 32).
# Firewall: open 7881/tcp, 7882-7883/udp, 3478/udp, 5349/tcp.
LIVEKIT_API_KEY=moznods
LIVEKIT_API_SECRET=generate-at-least-32-random-characters
# Web push (VAPID): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@your-domain.com

# 3. PostgreSQL
PGDATABASE=moznods
PGUSER=moznods
PGPASSWORD=generate-strong-postgres-password
PGHOST=postgres
PGPORT=5432
# Postgres runs in the same docker network without TLS.
PGSSLMODE=disable

# 4. Redis
REDIS_URL=redis://redis:6379/0


# 6. Django
DJANGO_SETTINGS_MODULE=config.settings.production
USE_SQLITE=0
USE_INMEMORY_CHANNELS=0

# 8. CSRF/Session cookies
CSRF_TRUSTED_ORIGINS=https://your-domain.com
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# 9. Static & Media
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# 10. CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com

# 11. Registration: when set, new users must enter this invite code (empty = open registration)
REGISTRATION_INVITE_CODE=your-secret-invite-code

# 12. Logging & Monitoring
SENTRY_DSN=
LOGTAIL_SOURCE_TOKEN=