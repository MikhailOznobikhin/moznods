# --- MOznoDS Production Configuration ---
# Copy this file to .env and fill in your values

# 1. Server Domain
DOMAIN=your-domain.com
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# 2. Security & Credentials
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-here
TURN_SECRET=generate-a-strong-random-secret-for-turn

# 3. PostgreSQL
PGDATABASE=moznods
PGUSER=moznods
PGPASSWORD=generate-strong-postgres-password
PGHOST=postgres
PGPORT=5432
PGSSLMODE=require

# 4. Redis
REDIS_URL=redis://redis:6379/0

# 5. Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# 6. Django
DJANGO_SETTINGS_MODULE=config.settings.production
USE_SQLITE=0
USE_INMEMORY_CHANNELS=0

# 8. CSRF/Session cookies
CSRF_TRUSTED_ORIGINS=https://your-domain.com
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# 9. Static & Media
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# 10. CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com

# 11. Registration (leave empty to disable registration)
REGISTRATION_INVITE_CODE=your-secret-invite-code

# 12. Logging & Monitoring
SENTRY_DSN=
LOGTAIL_SOURCE_TOKEN=