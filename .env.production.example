# --- MOznoDS Production Configuration ---
# Copy this file to .env and fill in your values

# 1. Server Domain
DOMAIN=your-domain.com
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# 2. Security & Credentials
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-here
TURN_SECRET=generate-a-strong-random-secret-for-turn
# TURN (coturn, use-auth-secret). Open 3478/udp+tcp and 49152-49999/udp in the firewall.
TURN_EXTERNAL_IP=your.server.public.ip
TURN_REALM=your-domain.com
# Optional: defaults to turn:<request host>:3478 over udp and tcp
# TURN_URLS=turn:your-domain.com:3478?transport=udp,turn:your-domain.com:3478?transport=tcp
# STUN_URLS=stun:your-domain.com:3478,stun:stun.voip.yandex.net:3478
# Seconds a dropped call socket may reconnect before others see the user leave
CALL_RECONNECT_GRACE_SECONDS=15

# 3. PostgreSQL
PGDATABASE=moznods
PGUSER=moznods
PGPASSWORD=generate-strong-postgres-password
PGHOST=postgres
PGPORT=5432
PGSSLMODE=require

# 4. Redis
REDIS_URL=redis://redis:6379/0


# 6. Django
DJANGO_SETTINGS_MODULE=config.settings.production
USE_SQLITE=0
USE_INMEMORY_CHANNELS=0

# 8. CSRF/Session cookies
CSRF_TRUSTED_ORIGINS=https://your-domain.com
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# 9. Static & Media
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/app/media

# 10. CORS
CORS_ALLOWED_ORIGINS=https://your-domain.com

# 11. Registration: when set, new users must enter this invite code (empty = open registration)
REGISTRATION_INVITE_CODE=your-secret-invite-code

# 12. Logging & Monitoring
SENTRY_DSN=
LOGTAIL_SOURCE_TOKEN=